POSTGRES_USER=wilkr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wilkr

# Host is "db" — the docker-compose service name, resolved on the compose network.
DATABASE_URL=postgresql+asyncpg://wilkr:change-me@db:5432/wilkr

# Only used for the initial `--login-only` run and garminconnect's own
# self-healing re-login fallback if the persisted session (garmin_tokens
# volume) is ever fully invalidated — the scheduled --loop service never
# does a fresh interactive login itself.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_SYNC_INTERVAL_S=3600
